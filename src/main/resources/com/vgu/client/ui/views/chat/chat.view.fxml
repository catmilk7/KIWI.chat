<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane fx:id="rootPane" minHeight="800.0" minWidth="1200.0" prefHeight="800.0" prefWidth="1200.0" stylesheets="@/com/vgu/client/ui/assets/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vgu.client.controllers.central.Chat">
    <children>
        <SplitPane fx:id="mainSplitPane" dividerPositions="0.25" prefHeight="800.0" prefWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <AnchorPane maxWidth="360.0" minWidth="240.0" prefHeight="200.0" prefWidth="300.0">
                    <children>
                        <VBox prefHeight="798.0" prefWidth="297.0" style="-fx-background-color: -color-bg-default;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" prefHeight="55.0" prefWidth="297.0" spacing="10.0" VBox.vgrow="NEVER">
                                    <padding>
                                        <Insets left="10.0" right="10.0" />
                                    </padding>
                                    <children>
                                        <TextField fx:id="searchField" promptText="Search contacts..." HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" styleClass="button-icon">
                                            <graphic>
                                                <FontIcon iconLiteral="fas-search" />
                                            </graphic>
                                        </Button>
                                    </children>
                                </HBox>

                                <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox fx:id="contactListContainer" spacing="8.0">
                                            <padding>
                                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                            </padding>
                                            <children>
                                                <HBox onMouseClicked="#openCreateGroupModal" alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="200.0" spacing="12.0" style="-fx-cursor: hand; -fx-padding: 5; -fx-background-radius: 8; -fx-border-color: lightgray; -fx-border-style: dashed; -fx-border-radius: 8; -fx-border-width: 1;">
                                                    <children>
                                                        <HBox alignment="CENTER" prefHeight="45.0" prefWidth="45.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 22.5;">
                                                            <children>
                                                                <FontIcon iconColor="#64748b" iconLiteral="fas-users" iconSize="20" />
                                                            </children>
                                                        </HBox>
                                                        <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Create/Join a group chat" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </content>
                                </ScrollPane>

                                <HBox alignment="CENTER_LEFT" prefHeight="65.0" prefWidth="297.0" spacing="10.0" style="-fx-border-color: lightgray; -fx-border-width: 1 0 0 0;">
                                    <padding>
                                        <Insets left="10.0" right="10.0" />
                                    </padding>
                                    <children>
                                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@/com/vgu/client/ui/assets/default/anon_user.png" />
                                            </image>
                                            <clip>
                                                <Circle centerX="20.0" centerY="20.0" radius="20.0" />
                                            </clip>
                                        </ImageView>
                                        <Label fx:id="currentUserNameLabel" style="-fx-font-weight: bold;" text="" />

                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#toggleAccountsMenu" styleClass="button-icon">
                                            <graphic>
                                                <FontIcon iconLiteral="fas-users" />
                                            </graphic>
                                        </Button>
                                        <Button onAction="#openUserSettingsModal" mnemonicParsing="false" styleClass="button-icon">
                                            <graphic>
                                                <FontIcon iconLiteral="fas-cog" />
                                            </graphic>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox fx:id="usersAccounts" managed="false" prefWidth="200.0" spacing="2.0" style="-fx-background-color: -color-bg-default; -fx-border-color: -color-border-default; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 4);" visible="false" AnchorPane.bottomAnchor="70.0" AnchorPane.rightAnchor="10.0">
                        </VBox>
                    </children>
                </AnchorPane>

                <AnchorPane prefHeight="200.0" prefWidth="200.0">
                    <children>
                        <VBox prefHeight="798.0" prefWidth="869.0" style="-fx-background-image: url('/com/vgu/client/ui/assets/background/kiwi_main.png'); -fx-background-size: cover; -fx-background-position: center center;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <children>
                                <HBox fx:id="chatHeader" managed="false" visible="false" alignment="CENTER_LEFT" prefHeight="65.0" prefWidth="869.0" spacing="10.0" style="-fx-background-color: -color-bg-default; -fx-border-color: lightgray; -fx-border-width: 0 0 1 0;">
                                    <padding>
                                        <Insets left="20.0" right="20.0" />
                                    </padding>
                                    <children>
                                        <ImageView fx:id="activeChatAvatar" fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@/com/vgu/client/ui/assets/default/anon_sender.png" />
                                            </image>
                                            <clip>
                                                <Circle centerX="20.0" centerY="20.0" radius="20.0" />
                                            </clip>
                                        </ImageView>
                                        <VBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label fx:id="activeChatUser" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="" />
                                                <HBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <Circle fx:id="activeChatStatus" fill="#2ecc71" radius="4.0" stroke="TRANSPARENT" />
                                                    <Label fx:id="activeChatStatusText" style="-fx-font-size: 11px;" text="" textFill="gray" />
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <Region HBox.hgrow="ALWAYS" />

                                        <Button fx:id="groupSettingsBtn" onAction="#openGroupSettingsModal" visible="false" managed="false" styleClass="button-icon">
                                            <graphic>
                                                <FontIcon iconLiteral="fas-cog" />
                                            </graphic>
                                        </Button>
                                        <Button mnemonicParsing="false" onAction="#toggleHeaderMenu" styleClass="button-icon">
                                            <graphic>
                                                <FontIcon iconLiteral="fas-ellipsis-v" />
                                            </graphic>
                                        </Button>
                                    </children>
                                </HBox>

                                <ScrollPane fx:id="messagesScrollPane" fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox fx:id="messagesContainer" spacing="20.0" style="-fx-background-color: transparent;">
                                            <padding>
                                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                                            </padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>

                                <HBox fx:id="inputBar" managed="false" visible="false" alignment="CENTER" prefHeight="80.0" prefWidth="869.0" spacing="15.0" style="-fx-background-color: -color-bg-default; -fx-border-color: lightgray; -fx-border-width: 1 0 0 0;">
                                    <padding>
                                        <Insets left="20.0" right="20.0" />
                                    </padding>
                                    <children>
                                        <TextArea fx:id="messageInput" prefHeight="50.0" promptText="Write a message..." style="-fx-max-height: 50;" wrapText="true" HBox.hgrow="ALWAYS" />

                                        <Button fx:id="attachmentsBtn" mnemonicParsing="false" onAction="#toggleAttachmentsMenu" styleClass="button-icon">
                                            <graphic>
                                                <FontIcon iconLiteral="fas-ellipsis-v" />
                                            </graphic>
                                        </Button>

                                        <Button fx:id="sendBtn" mnemonicParsing="false" onAction="#handleSendMessage" style="-fx-background-color: -color-accent-emphasis; -fx-text-fill: white; -fx-background-radius: 25; -fx-min-width: 40; -fx-min-height: 40;">
                                            <graphic>
                                                <FontIcon style="-fx-icon-color: #FFFFFF;" iconLiteral="fas-paper-plane" />
                                            </graphic>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox fx:id="attachmentsMenu" managed="false" prefWidth="175.0" spacing="2.0" style="-fx-background-color: -color-bg-default; -fx-border-color: -color-border-default; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 4);" visible="false" AnchorPane.bottomAnchor="85.0" AnchorPane.rightAnchor="60.0">
                            <children>
                                <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" maxWidth="Infinity" onAction="#handleAttachFile" style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-size: 13px;" text="Attach file">
                                    <graphic>
                                        <FontIcon style="-fx-icon-color: #808080;" iconLiteral="fas-file" />
                                    </graphic>
                                </Button>

                                <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-size: 13px;" text="Attach voice">
                                    <graphic>
                                        <FontIcon style="-fx-icon-color: #808080;" iconLiteral="fas-microphone" />
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>

                        <VBox fx:id="usersMenu" managed="false" prefWidth="175.0" spacing="2.0" style="-fx-background-color: -color-bg-default; -fx-border-color: -color-border-default; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 4);" visible="false" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="70.0">
                            <children>
                                <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-size: 13px;" text="Report user">
                                    <graphic>
                                        <FontIcon style="-fx-icon-color: #808080;" iconLiteral="fas-flag" />
                                    </graphic>
                                </Button>

                                <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-size: 13px;" text="Remove user">
                                    <graphic>
                                        <FontIcon style="-fx-icon-color: #808080;" iconLiteral="fas-user-minus" />
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>

        <VBox fx:id="messagesMenu" managed="false" prefWidth="125.0" spacing="2.0" style="-fx-background-color: -color-bg-default; -fx-border-color: -color-border-default; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 4);" visible="false">
            <children>
                <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-size: 13px;" text="Reply">
                    <graphic>
                        <FontIcon style="-fx-icon-color: #808080;" iconLiteral="fas-reply" />
                    </graphic>
                </Button>

                <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-size: 13px;" text="Forward">
                    <graphic>
                        <FontIcon style="-fx-icon-color: #808080;" iconLiteral="fas-share" />
                    </graphic>
                </Button>

                <Button alignment="BASELINE_LEFT" graphicTextGap="12.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-size: 13px;" text="Remove">
                    <graphic>
                        <FontIcon style="-fx-icon-color: #808080;" iconLiteral="fas-trash" />
                    </graphic>
                </Button>
            </children>
        </VBox>

        <VBox fx:id="groupsMenu" managed="false" prefWidth="175.0" spacing="2.0" style="-fx-background-color: -color-bg-default; -fx-border-color: -color-border-default; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 4);" visible="false">
            <children>
                <Button fx:id="toggleBell" alignment="BASELINE_LEFT" graphicTextGap="12.0" maxWidth="Infinity" onAction="#handleNotification" style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-size: 13px;" text="Mute">
                    <graphic>
                        <FontIcon fx:id="bell" style="-fx-icon-color: #808080;" iconLiteral="fas-bell-slash" />
                    </graphic>
                </Button>

                <Button fx:id="leaveMenuBtn" alignment="BASELINE_LEFT" graphicTextGap="12.0" maxWidth="Infinity" onAction="#handleLeaveGroup" style="-fx-background-color: transparent; -fx-padding: 10 15; -fx-cursor: hand; -fx-font-size: 13px;" text="Leave group">
                    <graphic>
                        <FontIcon style="-fx-icon-color: #808080;" iconLiteral="fas-sign-out-alt" />
                    </graphic>
                </Button>
            </children>
        </VBox>

        <VBox fx:id="usersProfile" managed="false" prefWidth="340.0" style="-fx-background-color: -color-bg-default; -fx-border-color: -color-border-default; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 4);" visible="false">
            <children>
                <AnchorPane prefHeight="110.0">
                    <children>
                        <Region prefHeight="65.0" style="-fx-background-color: -color-accent-emphasis; -fx-background-radius: 7 7 0 0;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

                        <StackPane layoutX="15.0" layoutY="25.0" style="-fx-background-color: -color-bg-default; -fx-background-radius: 50; -fx-padding: 5;">
                            <children>
                                <ImageView fitHeight="75.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@/com/vgu/client/ui/assets/default/anon_sender.png" />
                                    </image>
                                    <clip>
                                        <Circle centerX="37.5" centerY="37.5" radius="37.5" />
                                    </clip>
                                </ImageView>
                            </children>
                        </StackPane>

                    </children>
                </AnchorPane>

                <VBox spacing="15.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="5.0" />
                    </padding>
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Label fx:id="profileHandle" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>