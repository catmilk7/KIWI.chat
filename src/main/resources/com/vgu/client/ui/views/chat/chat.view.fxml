                                                                <Circle centerX="22.5" centerY="22.5" radius="22.5" />
                                                            </clip>
                                                        </ImageView>
                                                        <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="KIWI.chat development team" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                                                                <Label text="Milch: The deadline is tomorrow!" textFill="gray" style="-fx-font-size: 12px;" />
                                                            </children>
                                                        </VBox>
                                                        <VBox alignment="TOP_RIGHT" spacing="5.0" minWidth="-Infinity">
                                                            <children>
                                                                <Label text="10:42 AM" textFill="gray" style="-fx-font-size: 10px;" />
                                                                <Label text="3" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 1 6; -fx-background-radius: 10;" />
