                                                <!-- Contact Item: Active Chat (Jerry) -->
                                                <HBox alignment="CENTER_LEFT" spacing="12.0" prefHeight="60.0" prefWidth="200.0" style="-fx-cursor: hand; -fx-padding: 5; -fx-background-radius: 8; -fx-background-color: -color-bg-subtle;">
                                                    <children>
