                                                        <Insets top="15.0" bottom="5.0" />
                                                    </padding>
                                                    <children>
                                                        <Separator HBox.hgrow="ALWAYS" />
                                                        <Label text="Today" textFill="#71717a" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                                                        <Separator HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>

                                                <!-- SENDER MESSAGE 2 -->
                                                <HBox alignment="TOP_LEFT" spacing="10.0">
                                                    <children>
                                                        <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                                            <image>
